FACEBOOK_CLIENT_ID=1416342986709342
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FACE_SERVICE_URL=http://127.0.0.1:8001
FACE_SERVICE_TOKEN=replace_with_a_long_random_secret
FACE_VERIFICATION_ENABLED=true
FACE_SERVICE_TIMEOUT_SECONDS=20
FACE_SERVICE_MODEL=Facenet
FACE_SERVICE_DISTANCE_METRIC=cosine
FACE_SERVICE_THRESHOLD=0.40

# Optional local AWS credentials. Prefer an IAM role/provider chain where available.
# Never expose these values through VITE_* variables or frontend props.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Legacy AWS Rekognition values kept only for backup while the local service is being verified.
AWS_FACE_LIVENESS_REGION="${AWS_DEFAULT_REGION}"
AWS_COGNITO_IDENTITY_POOL_ID=
AWS_FACE_RECOGNITION_COLLECTION_ID=
FACE_LIVENESS_CONFIDENCE_THRESHOLD=80
FACE_RECOGNITION_MATCH_THRESHOLD=99
FACE_RECOGNITION_UNCERTAIN_THRESHOLD=90
VITE_AWS_FACE_LIVENESS_REGION="${AWS_FACE_LIVENESS_REGION}"
VITE_AWS_COGNITO_IDENTITY_POOL_ID="${AWS_COGNITO_IDENTITY_POOL_ID}"

VITE_APP_NAME="${APP_NAME}"

# Set these locally from an existing Meta application. Never commit the secret.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/facebook/callback
